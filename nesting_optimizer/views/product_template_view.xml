<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_product_template_form_nesting_optimizer" model="ir.ui.view">
            <field name="name">product.template.form.nesting.optimizer</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="before">
                    <header>
                        <widget name="dxf_file_uploader"/>
                        <field name="dxf_file" invisible="1"/>
                    </header>
                </xpath>
            </field>
        </record>
    </data>
</odoo>