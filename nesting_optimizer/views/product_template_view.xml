<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_product_template_form_nesting_optimizer" model="ir.ui.view">
            <field name="name">product.template.form.nesting.optimizer</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
<!--                <xpath expr="//sheet" position="before">-->
<!--                    <header>-->
<!--                        <widget name="dxf_file_uploader"/>-->
<!--                        <field name="dxf_file" invisible="1"/>-->
<!--                    </header>-->
<!--                </xpath>-->

                <!-- Add new page for upload dxf and svg files -->
                <xpath expr="//notebook" position="inside">
                    <page string="Glass Shapes">
                        <group>
                            <group invisible="1">
                                <field name="width"/>
                                <field name="height"/>
                                <field name="shape_points"/>
                            </group>
                            <group>
                                <field name="dxf_shape" widget="binary" filename="dxf_filename"/>
                            </group>
                            <group>
                                <field name="svg_shape" widget="binary" filename="svg_filename"/>
                            </group>
                        </group>
                    </page>
                </xpath>

            </field>
        </record>
    </data>
</odoo>