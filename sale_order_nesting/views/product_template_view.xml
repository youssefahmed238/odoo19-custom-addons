<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_product_template_form_nesting_optimizer" model="ir.ui.view">
            <field name="name">product.template.form.nesting.optimizer</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">

                <!-- Add new page for upload dxf and svg files -->
                <xpath expr="//notebook" position="inside">
                    <page string="Glass Shapes" invisible="is_product_variant">
                        <group>
                            <group invisible="1">
                                <field name="shape"/>

                                <field name="width"/>
                                <field name="height"/>
                            </group>
                            <group>
                                <field name="dxf_shape" widget="binary" filename="dxf_filename"/>
                            </group>
                        </group>
                    </page>
                </xpath>

            </field>
        </record>
    </data>
</odoo>